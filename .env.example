# Supabase project settings (required for persistent RSVP storage and admin list)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Private admin credentials. Set these in .env.local and Vercel Project Settings.
# Do NOT commit real usernames, phone numbers, or passwords to GitHub.
ADMIN_USERNAMES=ADD_COMMA_SEPARATED_ADMIN_USERNAMES
ADMIN_PASSWORD=SET_A_LONG_UNIQUE_RANDOM_PASSWORD

# Public event configuration
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
